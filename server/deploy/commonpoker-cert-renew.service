[Unit]
Description=Renew Common Poker IP TLS certificate
After=network-online.target nginx.service
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/opt/commonpoker-certbot/bin/certbot renew --quiet --cert-name commonpoker-ip
TimeoutStartSec=180
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
MemoryMax=128M
CPUQuota=25%
LogRateLimitIntervalSec=30s
LogRateLimitBurst=30
